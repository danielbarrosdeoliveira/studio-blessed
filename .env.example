# Banco de dados (Neon — PostgreSQL serverless)
# Desenvolvimento: postgres://studio:studio@localhost:5432/studio_blessed
# Produção: connection string do Neon (ex: postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/db?sslmode=require)
DATABASE_URL="postgres://studio:studio@localhost:5432/studio_blessed"

# Better Auth
# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL base da aplicação (ex: http://localhost:3000 ou https://seu-dominio.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Escopos necessários: calendar, calendar.events, userinfo.email, userinfo.profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API Key opcional (para endpoints públicos que não usam OAuth)
GOOGLE_API_KEY=

# Google Calendar Configuration (Server-to-Server)
# Lista de Calendar IDs para checar disponibilidade (conflitos).
# Separe por vírgula. Exemplos: "primary", "seu-email@gmail.com", "endereco_da_agenda@group.calendar.google.com"
# Padrão: "primary"
# Para descobrir os IDs, acesse /api/google-calendar/calendars após conectar a conta
GOOGLE_CALENDAR_AVAILABILITY_IDS=primary

# Calendar ID onde novos eventos serão criados.
# Padrão: "primary"
# Recomendado: crie uma agenda dedicada "Studio Blessed" e use o ID dela aqui
GOOGLE_CALENDAR_CREATE_ID=primary