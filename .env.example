# Banco de dados (Neon — PostgreSQL serverless para produção)
# Exemplo: postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/banco?sslmode=require
DATABASE_URL=postgres://studio:studio@localhost:5432/studio_blessed

# Better Auth
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-de-32-bytes
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (integração com Calendar — fase final do MVP)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Node
NODE_ENV=production
