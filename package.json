{
  "name": "studio-blessed",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "pnpm test:db:setup && vitest run --project integration-api --project integration-nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:db:setup": "tsx scripts/test-db.ts",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:coverage": "tsx scripts/coverage.ts all",
    "test:coverage:unit": "tsx scripts/coverage.ts unit",
    "test:coverage:integration": "tsx scripts/coverage.ts integration",
    "test:coverage:integration-api": "tsx scripts/coverage.ts integration-api",
    "test:coverage:integration-nuxt": "tsx scripts/coverage.ts integration-nuxt",
    "test:coverage:e2e": "tsx scripts/coverage.ts e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.100",
    "@internationalized/date": "^3.12.4",
    "@neondatabase/serverless": "^0.10.4",
    "@nuxt/ui": "^4.12.0",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/table-core": "^8.21.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-auth": "^1.7.12",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.2",
    "pg": "^8.16.0",
    "postgres": "^3.4.9",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "c8": "^10.1.3",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.15.0"
}
